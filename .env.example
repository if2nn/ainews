# Soniox (TTS + optional ASR check) https://soniox.com
SONIOX_KEY=
# Preset voice name or your own cloned voice id
SONIOX_VOICE=Adrian
# OpenRouter key for free models (script writing); leave empty to use rule-based fallback
ORFREE_KEY=
# Output root (default ./output)
# AINEWS_LIB=
# Email version
MAIL_FROM=me@example.com
MAIL_TO=you@example.com
